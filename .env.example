# Materials Project API key
# Get your key from: https://next-gen.materialsproject.org/api
MP_API_KEY=replace_with_your_materials_project_api_key

# Optional local output directory
MP_DATA_ROOT=data/dft/mp

# Optional NOMAD API token (public data works without it; tokens raise rate limits
# and are required for non-public resources)
# NOMAD_API_TOKEN=replace_with_your_nomad_api_token

# Optional local output directory
NOMAD_DATA_ROOT=data/dft/nomad

# Catalysis-Hub API key (free)
# Get your key from: https://api-catalysis-hub.slac.stanford.edu/auth/login
# CATALYSIS_HUB_API_KEY=replace_with_your_catalysis_hub_api_key

# Optional local output directory
# CATALYSIS_HUB_DATA_ROOT=data/dft/catalysishub

# Hugging Face endpoint for MatPES / QMOF (set to a mirror outside the default region)
# HF_ENDPOINT=https://huggingface.co
